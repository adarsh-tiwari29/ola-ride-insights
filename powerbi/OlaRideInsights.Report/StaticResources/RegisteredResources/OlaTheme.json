{
  "name": "OLA Ride Insights",
  "dataColors": [
    "#8CC63F",
    "#1F2A2E",
    "#F3A712",
    "#E4572E",
    "#9AA5A9",
    "#3E7CB1",
    "#7B5EA7",
    "#2BA84A",
    "#F6D55C",
    "#20639B"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2A2E",
  "tableAccent": "#8CC63F",
  "good": "#8CC63F",
  "bad": "#E4572E",
  "neutral": "#F3A712",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#1F2A2E"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#3B4648"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 24,
      "color": "#1F2A2E"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#1F2A2E"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#D9DEDF"
              }
            },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#1F2A2E"
              }
            },
            "fontSize": 12,
            "bold": true
          }
        ],
        "visualHeader": [
          {
            "show": true
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#1F2A2E"
              }
            },
            "fontSize": 22,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#5F6B6D"
              }
            },
            "fontSize": 10
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#8CC63F"
              }
            },
            "radius": 10
          }
        ],
        "title": [
          {
            "show": false
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#8CC63F"
              }
            },
            "radius": 8
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ]
      }
    },
    "page": {
      "*": {
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F2F2F2"
              }
            }
          }
        ]
      }
    }
  }
}