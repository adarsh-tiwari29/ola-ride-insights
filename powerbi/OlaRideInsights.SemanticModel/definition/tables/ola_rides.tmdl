table ola_rides
	lineageTag: 79726503-f0b3-55f4-a3a1-2247bbcf3cc9

	measure 'Total Bookings' = COUNTROWS ( ola_rides )
		formatString: #,0
		displayFolder: 1 Volume
		lineageTag: fa08838d-22df-5c45-8e90-06a3981c37ba

	measure 'Successful Rides' = CALCULATE ( COUNTROWS ( ola_rides ), ola_rides[Booking_Status] = "Success" )
		formatString: #,0
		displayFolder: 1 Volume
		lineageTag: 3d8cf1c4-de52-5fab-aabf-d444e71b6c97

	measure 'Success Rate %' = DIVIDE ( [Successful Rides], [Total Bookings] )
		formatString: 0.0%
		displayFolder: 1 Volume
		lineageTag: cfca85f0-ba6c-5dd3-93d9-7d9a85082c75

	measure 'Incomplete Rides' = CALCULATE ( COUNTROWS ( ola_rides ), ola_rides[Incomplete_Rides] = "Yes" )
		formatString: #,0
		displayFolder: 1 Volume
		lineageTag: 4b21b3bf-99d7-590f-a67a-26d41982eea7

	measure 'Unique Customers' = DISTINCTCOUNT ( ola_rides[Customer_ID] )
		formatString: #,0
		displayFolder: 1 Volume
		lineageTag: 0cc4344a-4317-5bbf-8b7c-31eb74e5d95e

	measure 'Canceled by Customer' = CALCULATE ( COUNTROWS ( ola_rides ), ola_rides[Booking_Status] = "Canceled by Customer" )
		formatString: #,0
		displayFolder: 2 Cancellation
		lineageTag: 5325cde7-9c43-5734-8e0c-3abc8fbb6162

	measure 'Canceled by Driver' = CALCULATE ( COUNTROWS ( ola_rides ), ola_rides[Booking_Status] = "Canceled by Driver" )
		formatString: #,0
		displayFolder: 2 Cancellation
		lineageTag: d803e146-a356-5750-bedd-3fa49dfd45af

	measure 'Driver Not Found' = CALCULATE ( COUNTROWS ( ola_rides ), ola_rides[Booking_Status] = "Driver Not Found" )
		formatString: #,0
		displayFolder: 2 Cancellation
		lineageTag: b72351bf-1551-5480-b980-d84dcbd1c391

	measure 'Total Cancellations' = [Canceled by Customer] + [Canceled by Driver]
		formatString: #,0
		displayFolder: 2 Cancellation
		lineageTag: 6dd6d590-3860-5a52-b87f-740c83abe163

	measure 'Cancellation Rate %' = DIVIDE ( [Total Cancellations], [Total Bookings] )
		formatString: 0.0%
		displayFolder: 2 Cancellation
		lineageTag: bc1f1205-52bf-5661-ad41-b29bd1cd7adb

	measure 'Total Booking Value' = SUM ( ola_rides[Booking_Value] )
		formatString: ₹#,0
		displayFolder: 3 Revenue
		lineageTag: 4fc71004-978b-5270-8104-f2285473e58d

	measure 'Total Revenue' = CALCULATE ( SUM ( ola_rides[Booking_Value] ), ola_rides[Booking_Status] = "Success" )
		formatString: ₹#,0
		displayFolder: 3 Revenue
		lineageTag: 93eac503-9b08-5488-8f0f-a7aae561ed2b

	measure 'Avg Booking Value' = CALCULATE ( AVERAGE ( ola_rides[Booking_Value] ), ola_rides[Booking_Status] = "Success" )
		formatString: ₹#,0
		displayFolder: 3 Revenue
		lineageTag: f41368ff-7296-5f4f-aa50-52442d9bdb60

	measure 'Lost Booking Value' = [Total Booking Value] - [Total Revenue]
		formatString: ₹#,0
		displayFolder: 3 Revenue
		lineageTag: db41d8fc-7089-5078-bc8a-27f74b8634b9

	measure 'Digital Payment Share %' = DIVIDE ( CALCULATE ( [Successful Rides], ola_rides[Payment_Method] IN { "UPI", "Credit Card", "Debit Card" } ), [Successful Rides] )
		formatString: 0.0%
		displayFolder: 3 Revenue
		lineageTag: d23f183d-708a-50c7-a531-10c734d21e5d

	measure 'Total Distance' = CALCULATE ( SUM ( ola_rides[Ride_Distance] ), ola_rides[Booking_Status] = "Success" )
		formatString: #,0
		displayFolder: 4 Distance
		lineageTag: d47dd1f0-f605-5fbf-9f88-15b3c80d4df8

	measure 'Avg Ride Distance' = CALCULATE ( AVERAGE ( ola_rides[Ride_Distance] ), ola_rides[Booking_Status] = "Success" )
		formatString: #,0.0
		displayFolder: 4 Distance
		lineageTag: 54c729b8-afd5-5dc9-9d0e-777545814c17

	measure 'Avg Driver Rating' = AVERAGE ( ola_rides[Driver_Ratings] )
		formatString: 0.00
		displayFolder: 5 Ratings
		lineageTag: d9585768-00bf-5fd7-8b05-7ad183517900

	measure 'Avg Customer Rating' = AVERAGE ( ola_rides[Customer_Rating] )
		formatString: 0.00
		displayFolder: 5 Ratings
		lineageTag: bd0a2140-ee21-51df-ae77-41b77fa7c6a7

	measure 'Avg V_TAT' = AVERAGE ( ola_rides[V_TAT] )
		formatString: 0.0
		displayFolder: 5 Ratings
		lineageTag: ea9b6968-e3e9-545f-a940-eb5156f02298

	measure 'Avg C_TAT' = AVERAGE ( ola_rides[C_TAT] )
		formatString: 0.0
		displayFolder: 5 Ratings
		lineageTag: 3ede58d7-3d80-5459-8b76-264123263a77

